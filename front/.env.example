# 前端环境变量示例。复制为 front/.env.local 后填入真实值（.env.local 不进版本库）。
#
# ⚠ 前端只允许使用 anon public key —— 它受 RLS 约束。
#   service key 只属于后端 backend/.env，任何情况下都不得出现在 front/ 下。

VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon public key>

# 后端地址。开发环境留空时按当前主机推断 http://<hostname>:8000。
# 生产环境必须填写完整 HTTPS 地址；缺失或使用 HTTP 时前端会拒绝启动。
VITE_API_BASE_URL=
