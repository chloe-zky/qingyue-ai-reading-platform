SUPABASE_URL=""
SUPABASE_SERVICE_KEY=""
# 旧版共享后台 Token，仅供迁移期本地排障；正式鉴权不再使用。
ADMIN_TOKEN=""
APP_ENV="development"
FRONTEND_ORIGIN="http://localhost:5173"
# 多个固定来源可用英文逗号分隔。development 环境会额外放行私网 IP 的 5173 端口。
FRONTEND_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
# 生产环境必填：AI 上游域名精确白名单，多个域名用英文逗号分隔。
# 示例仅为格式说明，请填写实际供应商域名，不要填写完整 URL 或密钥。
LLM_ALLOWED_HOSTS=""
# 默认 false。仅当本机代理/VPN 使用 198.18.0.0/15 Fake-IP DNS，且上方为
# 精确域名白名单时才设为 true；不会放行普通私网、回环或其他保留地址。
LLM_TRUST_PROXY_DNS="false"
# 后端专用的 AI 配置加密密钥环，格式为 key-id:base64url-32-byte-key。
# 多把密钥用英文逗号分隔，第一把用于新加密，其余仅用于平滑轮换解密。
# 请用 backend/tools/rotate_llm_key.py 在本机生成，不要提交真实值。
LLM_CONFIG_MASTER_KEYS=""
